//
// Machine-specific build settings. Copy this file to Local.xcconfig (which git ignores)
// and edit it. Anything set here overrides Inform.xcconfig.
//

// Rebuild Inform Core and refresh StagingArea on every build.
INFORM_CORE_UPDATE = YES

// Location of the Inform Core 'inform' repository, if not the default.
// INFORM_CORE_DIR = /path/to/Inform Core/inform
